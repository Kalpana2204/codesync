{
  "name": "codesync-vscode",
  "displayName": "CodeSync - Collaborative IDE & Sync",
  "description": "Bi-directional synchronization between local VS Code workspaces and CodeSync collaborative rooms, featuring Gemini AI code review.",
  "version": "1.0.0",
  "publisher": "codesync",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Collaboration",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codesync.connect",
        "title": "CodeSync: Connect to Workspace Room",
        "category": "CodeSync"
      },
      {
        "command": "codesync.sync",
        "title": "CodeSync: Push/Pull Workspace Sync",
        "category": "CodeSync"
      },
      {
        "command": "codesync.disconnect",
        "title": "CodeSync: Disconnect from Workspace",
        "category": "CodeSync"
      },
      {
        "command": "codesync.aiReview",
        "title": "CodeSync: AI Review Current File (Gemini)",
        "category": "CodeSync"
      }
    ],
    "configuration": {
      "title": "CodeSync Configuration",
      "properties": {
        "codesync.serverUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "CodeSync Backend Server URL"
        },
        "codesync.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize file saves with CodeSync"
        },
        "codesync.excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/.env*",
            "**/dist/**",
            "**/build/**",
            "**/.vscode/**"
          ],
          "description": "Glob patterns of files and folders excluded from synchronization."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "socket.io-client": "^4.7.4"
  }
}
